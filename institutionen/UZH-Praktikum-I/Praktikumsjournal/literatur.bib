@article{deci1993,
  title = {Die Selbstbestimmungstheorie der Motivation und ihre Bedeutung für die Pädagogik},
  author = {Deci, Edward L. and Ryan, Richard M.},
  date = {1993},
  journaltitle = {Zeitschrift für Pädagogik},
  volume = {39},
  number = {2},
  pages = {223--238},
  publisher = {pedocs},
